{
  "name": "rentalai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @rentalai/web dev",
    "build": "pnpm --filter @rentalai/web build",
    "lint": "pnpm --filter @rentalai/web lint",
    "db:generate": "pnpm --filter @rentalai/web db:generate",
    "db:push": "pnpm --filter @rentalai/web db:push",
    "db:seed": "pnpm --filter @rentalai/web db:seed",
    "typecheck": "pnpm --filter @rentalai/web typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
