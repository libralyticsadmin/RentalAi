# Copy to apps/web/.env.local (or repo root .env) before running.

# Database — SQLite for local Phase 0 (Postgres-ready schema via Prisma)
DATABASE_URL="file:./dev.db"

# Auth mode:
#   mock  — no external secrets; auto-signs a demo org user (default for local)
#   clerk — requires Clerk keys below (optional later)
AUTH_MODE="mock"

# Optional Clerk (only when AUTH_MODE=clerk)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
